{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.rechenhafen.de"
        }
      ],
      "destination": "https://rechenhafen.de/$1",
      "permanent": true
    }
  ]
}
